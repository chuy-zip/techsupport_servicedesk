# Copiar a .env.local y llenar con las cadenas de la rama dev de Neon

# Conexión con pooler, el host lleva -pooler. La usa la aplicación
DATABASE_URL=""

# Conexión directa, sin pooler. La usan las migraciones de Prisma y el seed
DIRECT_URL=""

# Contraseña de los usuarios de demostración que crea el seed
SEED_PASSWORD=""

# Firma las cookies de sesión. Uno propio por persona, nunca el de producción
SESSION_SECRET=""
